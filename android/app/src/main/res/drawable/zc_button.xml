<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/zc_green" />
            <stroke android:width="2dp" android:color="@color/zc_green" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/zc_background" />
            <stroke android:width="2dp" android:color="@color/zc_panel_edge" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/zc_panel" />
            <stroke android:width="2dp" android:color="@color/zc_cyan" />
        </shape>
    </item>
</selector>
