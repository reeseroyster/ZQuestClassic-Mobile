diff --git i/src/android/android_display.c w/src/android/android_display.c
index d5ccdf689..8a6d4a4cf 100644
--- i/src/android/android_display.c
+++ w/src/android/android_display.c
@@ -234,11 +234,21 @@ void _al_android_destroy_surface(JNIEnv *env, jobject surface, bool post)
 
 void  _al_android_make_current(JNIEnv *env, ALLEGRO_DISPLAY_ANDROID *d)
 {
+   /* al_uninstall_system runs registered destructors newest first, so a bitmap
+      can be destroyed after the display it belongs to, leaving display->android
+      or its surface NULL. Calling into the surface then dereferences NULL and
+      kills the process during an otherwise clean shutdown. */
+   if (d == NULL || d->surface_object == NULL)
+      return;
+
    _jni_callVoidMethodV(env, d->surface_object, "egl_makeCurrent", "()V");
 }
 
 void _al_android_clear_current(JNIEnv *env, ALLEGRO_DISPLAY_ANDROID *d)
 {
+   if (d == NULL || d->surface_object == NULL)
+      return;
+
    _jni_callVoidMethodV(env, d->surface_object, "egl_clearCurrent", "()V");
 }
 
